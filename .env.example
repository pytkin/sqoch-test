# Backend reads process environment. For a local key:
# uv run --env-file .env --project backend --locked <command>
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
SQOCH_DATABASE_PATH=data/sqoch.sqlite3
SQOCH_SMTP_HOST=127.0.0.1
SQOCH_SMTP_PORT=1025
SQOCH_MAILPIT_URL=http://127.0.0.1:8025
